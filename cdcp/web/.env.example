# Anthropic API key for the hybrid eligibility chat (natural-language understanding).
# The eligibility VERDICT is always deterministic; the LLM only parses free-text answers
# and explains results. If this is unset, the chat falls back to button-only mode and
# still works fully.
ANTHROPIC_API_KEY=

# Public site origin, used for canonical URLs, sitemap, and hreflang.
NEXT_PUBLIC_SITE_URL=https://cdcpguide.ca
